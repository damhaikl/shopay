<%- include('../partials/header') %>
<%- include('../partials/nav') %>
<div class="container" style="max-width:700px">
  <a href="/products" class="btn btn-ghost btn-sm" style="margin-bottom:1.2rem">← Back to Shop</a>
  <div class="card">
    <% if (product.image) { %>
      <img src="/products/image/<%= product.image %>" alt="<%= product.name %>" style="width:100%;height:300px;object-fit:contain;background:#f5f5f5;border-radius:8px;margin-bottom:1.5rem;display:block">
    <% } else { %>
      <div style="height:200px;background:linear-gradient(135deg,var(--accent-light),#f0f7ff);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:5rem;margin-bottom:1.5rem">🛍️</div>
    <% } %>
    <div style="font-size:0.8rem;font-weight:600;color:var(--accent);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:0.4rem"><%= product.category %></div>
    <h1 style="font-size:1.6rem;font-weight:700;margin-bottom:0.6rem"><%= product.name %></h1>
    <p style="color:var(--gray);line-height:1.6;margin-bottom:1.2rem"><%= product.description || 'No description available.' %></p>
    <div style="display:flex;align-items:center;justify-content:space-between;padding-top:1rem;border-top:1px solid var(--light)">
      <div>
        <div style="font-size:1.8rem;font-weight:700">RM <%= parseFloat(product.price).toFixed(2) %></div>
        <div style="font-size:0.85rem;color:var(--gray);margin-top:0.2rem">
          <% if (product.stock === 0) { %><span style="color:var(--danger)">Out of stock</span>
          <% } else { %><span style="color:var(--success)"><%= product.stock %> units available</span><% } %>
        </div>
      </div>
      <% if (user.role === 'admin') { %>
<div style="display:flex;gap:0.5rem">
  <a href="/products/edit/<%= product.id %>" class="btn btn-ghost">Edit</a>
  <form action="/products/delete/<%= product.id %>" method="POST" onsubmit="return confirm('Delete this product?')">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button type="submit" class="btn btn-danger">Delete</button>
  </form>
</div>
<% } else { %>
  <% if (product.stock > 0) { %>
    <a href="/products/buy/<%= product.id %>" class="btn btn-primary" style="padding:0.7rem 2rem;font-size:1rem">Buy Now</a>
  <% } else { %>
    <button class="btn btn-primary" disabled style="padding:0.7rem 2rem;font-size:1rem;opacity:0.5;cursor:not-allowed">Out of Stock</button>
  <% } %>
<% } %>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
