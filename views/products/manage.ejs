<%- include('../partials/header') %>
<%- include('../partials/nav') %>
<div class="container">
  <div class="page-header">
    <h1 class="page-title">Manage Products</h1>
    <a href="/products/create" class="btn btn-primary">+ Add Product</a>
  </div>
  <div class="card">
    <% if (products.length === 0) { %>
      <p style="text-align:center;color:var(--gray);padding:2rem">No products yet. <a href="/products/create">Add one →</a></p>
    <% } else { %>
    <table>
      <thead><tr><th>Image</th><th>Name</th><th>Category</th><th>Price</th><th>Stock</th><th>Actions</th></tr></thead>
      <tbody>
        <% products.forEach(p => { %>
        <tr>
          <td>
            <% if (p.image) { %>
              <img src="/products/image/<%= p.image %>" alt="<%= p.name %>"
                style="width:48px;height:48px;object-fit:cover;border-radius:6px;border:1px solid var(--border-color,#eee)">
            <% } else { %>
              <div style="width:48px;height:48px;border-radius:6px;background:var(--light,#f5f5f5);display:flex;align-items:center;justify-content:center;font-size:1.4rem">🛍️</div>
            <% } %>
          </td>
          <td><strong><%= p.name %></strong></td>
          <td style="color:var(--gray)"><%= p.category %></td>
          <td>RM <%= parseFloat(p.price).toFixed(2) %></td>
          <td>
            <% if (p.stock === 0) { %><span class="badge badge-out">Out</span>
            <% } else if (p.stock < 5) { %><span class="badge badge-low"><%= p.stock %></span>
            <% } else { %><span class="badge badge-in-stock"><%= p.stock %></span><% } %>
          </td>
          <td style="display:flex;gap:0.4rem">
            <a href="/products/edit/<%= p.id %>" class="btn btn-ghost btn-sm">Edit</a>
            <form action="/products/delete/<%= p.id %>" method="POST" onsubmit="return confirm('Delete?')">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-danger btn-sm">Delete</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <% } %>
  </div>
</div>
<%- include('../partials/footer') %>
