<%- include('../partials/header') %>
<%- include('../partials/nav') %>
<div class="container">
  <div class="page-header">
    <h1 class="page-title">Shop</h1>
    <form action="/products" method="GET" style="display:flex;gap:0.5rem">
      <input class="form-input" style="width:220px" type="text" name="search" value="<%= search %>" placeholder="Search products...">
      <button type="submit" class="btn btn-ghost">Search</button>
      <% if (search) { %><a href="/products" class="btn btn-ghost">Clear</a><% } %>
    </form>
  </div>
  <% if (products.length === 0) { %>
    <div class="card" style="text-align:center;padding:3rem">
      <p style="color:var(--gray);font-size:1.1rem">No products found.</p>
    </div>
  <% } else { %>
  <div class="product-grid">
    <% products.forEach(p => { %>
    <a href="/products/view/<%= p.id %>" style="text-decoration:none;color:inherit">
      <div class="product-card">
        <div class="product-img">
          <% if (p.image) { %>
            <img src="/products/image/<%= p.image %>" alt="<%= p.name %>" style="width:100%;height:100%;object-fit:contain;background:#f5f5f5">
          <% } else { %>
            🛍️
          <% } %>
        </div>
        <div class="product-body">
          <div class="product-category"><%= p.category %></div>
          <div class="product-name"><%= p.name %></div>
          <div class="product-price">RM <%= parseFloat(p.price).toFixed(2) %></div>
          <div class="product-stock">
            <% if (p.stock === 0) { %><span style="color:var(--danger)">Out of stock</span>
            <% } else if (p.stock < 5) { %><span style="color:var(--warning)">Only <%= p.stock %> left</span>
            <% } else { %><span style="color:var(--success)"><%= p.stock %> available</span><% } %>
          </div>
        </div>
      </div>
    </a>
    <% }) %>
  </div>
  <% } %>
</div>
<%- include('../partials/footer') %>
