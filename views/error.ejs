<%- include('partials/header') %>
<div style="min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:2rem">
  <div style="font-size:6rem;font-weight:800;color:var(--light);letter-spacing:-4px"><%= code %></div>
  <h1 style="font-size:1.3rem;font-weight:600;margin-top:-0.5rem;margin-bottom:0.6rem">Oops!</h1>
  <p style="color:var(--gray);max-width:380px;line-height:1.6"><%= message %></p>
  <a href="/" class="btn btn-primary" style="margin-top:1.5rem">Go Home</a>
</div>
<%- include('partials/footer') %>
